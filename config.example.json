  "scoring": {
    "min_fit_score": 75,
    "original_cv_ok_threshold": 88,
    "strictness": "strict",
    "weights": {
      "role_and_seniority": 0.35,
      "hard_skills_and_tools": 0.35,
      "domain_and_responsibilities": 0.3
    },
    "penalties": {
      "years_required_gap_per_year": 10,
      "missing_required_language_cap": 20,
      "location_or_work_mode_mismatch": "drop"
    }
  },
  "cv": {
    "max_pages": 1,
    "page_size": "A4",
    "margins_inch": {
      "top": 0.5,
      "bottom": 0.5,
      "left": 0.5,
      "right": 0.5
    },
    "font_family": "Arial",
    "font_size_body_pt": 10,
    "accent_color": "#215E99",
    "section_order": [
      "summary",
      "skills",
      "experience",
      "education",
      "certifications",
      "languages"
    ],
    "summary_max_lines": 4,
    "bullets_most_recent_role": {
      "min": 3,
      "max": 4
    },
    "bullets_older_roles": {
      "min": 2,
      "max": 3
    },
    "max_roles_shown": 4,
    "min_quantified_bullets": 3,
    "show_learning_line": true,
    "max_learning_items": 3,
    "output_formats": [
      "pdf"
    ],
    "file_name_template": "CV_{full_name}_{company}_{date}",
    "local_output_dir": "output_resumes",
    "never_overwrite": true
  },
  "tracking": {
    "storage": "google_sheets",
    "local_state_file": "runs/tracker.json",
    "tab_strategy": "weekly",
    "tab_name_template": "Week_{iso_week}_{year}",
    "columns": [
      "Job Title",
      "Company",
      "Location / Work Type",
      "Fit Score (%)",
      "Posted Date",
      "Source",
      "Apply Link",
      "CV Action",
      "Tailored CV Link",
      "Application Status",
      "AI Fit & Tailoring Notes",
      "ATS Keywords Matched",
      "ATS Keywords Missing",
      "Job ID"
    ],
    "statuses": [
      "New",
      "Applied",
      "Interviewing",
      "Offer",
      "Rejected",
      "Skipped"
    ],
    "closed_statuses": [
      "Applied",
      "Interviewing",
      "Offer",
      "Rejected",
      "Skipped"
    ]
  },
  "integrations": {
    "firecrawl": {
      "required": true,
      "mode": "mcp",
      "api_key_env": "FIRECRAWL_API_KEY",
      "scrape_formats": [
        "markdown"
      ],
      "only_main_content": true,
      "max_scrapes_per_run": 80,
      "rate_limit_per_minute": 10,
      "search_results_per_query": 20,
      "search_time_filter": "qdr:w",
      "status": "unchecked",
      "last_checked_at": null
    },
    "apify": {
      "required": false,
      "mode": "mcp",
      "api_token_env": "APIFY_TOKEN",
      "use_for": [
        "linkedin",
        "scheduled_runs"
      ],
      "status": "unchecked",
      "last_checked_at": null,
      "max_results_per_search": 50,
      "fallback_to_firecrawl": true
    },
    "google": {
      "required": true,
      "drive": {
        "root_folder_name": "Job Search Full-Ops Agent",
        "root_folder_id": null,
        "cv_subfolder_name": "Tailored CVs",
        "cv_subfolder_id": null
      },
      "sheets": {
        "tracking_spreadsheet_id": null,
        "template_tab_name": "Template"
      },
      "gmail": {
        "enabled": true
      },
      "permissions": {
        "create_files_in_drive": false,
        "granted_at": null
      },
      "status": "unchecked",
      "last_checked_at": null
    }
  },
  "notifications": {
    "email": {
      "enabled": true,
      "provider": "gmail_mcp",
      "recipients": [
        "you@example.com"
      ],
      "subject_template": "[Job Match Digest] {new_count} new roles — {date}",
      "min_fit_to_include": 75,
      "near_miss_margin": 10,
      "max_rows_in_table": 15,
      "link_tracking_sheet": true,
      "link_tailored_cvs": true,
      "send_when_no_matches": false
    },
    "schedule": {
      "enabled": true,
      "orchestrator": "claude_scheduled_task",
