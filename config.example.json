{
  "$schema": "./schemas/config.schema.json",
  "schema_version": 1,
  "locale": {
    "timezone": "Europe/Berlin",
    "ui_language": "en",
    "date_format": "YYYY-MM-DD"
  },
  "profile_quality": {
    "min_bullets_per_role": 3,
    "min_metric_bullets_per_role": 1,
    "min_responsibilities_last_role": 3,
    "about_me_sentences": {
      "min": 5,
      "max": 6
    },
    "min_core_skills": 5,
    "roles_checked": 4,
    "max_followups_per_gap": 2
  },
  "search": {
    "first_run_lookback_days": 14,
    "max_lookback_days": 21,
    "max_jobs_per_run": 60,
    "deduplicate_across_runs": true,
    "drop_if_jd_language_not_in_profile": true,
    "boards": [
      {
        "id": "linkedin",
        "name": "LinkedIn Jobs",
        "enabled": true,
        "category": "aggregator",
        "region": "europe",
        "coverage": "pan_eu",
        "countries": [
          "*"
        ],
        "method": "apify_actor",
        "domains": {
          "*": "linkedin.com/jobs/view"
        },
        "listing_languages": [
          "en"
        ],
        "query_template": "site:{domain} \"{title}\" \"{location}\"",
        "apify_actor": "curious_coder/linkedin-jobs-scraper",
        "notes": "Primary: Apify actor (structured jobs, date/location filters, about $0.002 per job). Fallback: Firecrawl site search with 'City, Country' as {location} (a bare 'Berlin' also matches Berlin, NJ). Public job pages only; never log in.",
        "job_url_pattern": "linkedin\\.com/jobs/view/",
        "verified": "2026-11-07",
        "fallback_method": "firecrawl_search",
        "apify_actor_input": {
          "scrapeCompany": false,
          "limitPerSource": 50
        },
        "added_by": "catalog",
        "always_on": true
      },
      {
        "id": "web_search",
        "name": "Web search (all sites: employer career pages, smaller boards)",
        "enabled": true,
        "always_on": true,
        "added_by": "catalog",
        "category": "aggregator",
        "region": "europe",
        "coverage": "pan_eu",
        "countries": [
          "*"
        ],
        "method": "firecrawl_web_search",
        "listing_languages": [
          "en"
        ],
        "query_template": "\"{title}\" \"{location}\" job",
        "exclude_domains": [
          "facebook.com",
          "instagram.com",
          "x.com",
          "twitter.com",
          "reddit.com",
          "quora.com",
          "youtube.com",
          "levels.fyi",
          "payscale.com",
          "salary.com",
          "salaryexpert.com",
          "glassdoor.com",
          "indeed.com",
          "linkedin.com"
        ],
        "notes": "Open web search, like a Google search, run through Firecrawl's search. Finds employer career pages and boards not in the catalog (live test: Takeda, Nestle and consulting-firm career pages for 'Project Manager' in Lisbon). No fixed job_url_pattern: each hit's page is checked for a single job ad. Boards already searched directly and noise sites are excluded.",
        "verified": "2026-11-08"
      },
