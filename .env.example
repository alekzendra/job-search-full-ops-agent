# Job Search Full-Ops Agent - secrets only. Copy to .env and fill in. .env is gitignored; never commit it.
# Leave a value empty if you use the MCP connector for that service (the connector holds its own credentials).

# Firecrawl - required only when config.integrations.firecrawl.mode = "api"
FIRECRAWL_API_KEY=

# Apify - optional; only when config.integrations.apify.mode = "api"
APIFY_TOKEN=

# SMTP - only when config.notifications.email.provider = "smtp"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
